void handleMaterialTouch(uint16_t x, uint16_t y) {
  if (x >= 380 && x <= 470 && y >= 4 && y <= 30) {
    current_view = VIEW_LOGIN;
    drawFullUI();
    return;
  }

  int card_y = 42;
  int card_h = 62;

  for (int i = 0; i < TOTAL_MATERIALS; i++) {
    if (y >= card_y && y <= (card_y + card_h)) {
      selected_material_idx = i;
      piece_count = 0;
      current_view = VIEW_METROSURE;
      drawFullUI();
      return;
    }
    card_y += card_h + 6;
  }
}

