// ==========================================
// --- Conversion Helpers ---
// ==========================================
float convertFromMM(float mm, UnitMode u) {
  switch (u) {
    case UNIT_CM:   return mm / 10.0f;
    case UNIT_M:    return mm / 1000.0f;
    case UNIT_INCH: return mm / 25.4f;
    default:        return mm;
  }
}

float convertToMM(float val, UnitMode u) {
  switch (u) {
    case UNIT_CM:   return val * 10.0f;
    case UNIT_M:    return val * 1000.0f;
    case UNIT_INCH: return val * 25.4f;
    default:        return val;
  }
}

const char* getUnitStr(UnitMode u) {
  switch (u) {
    case UNIT_CM:   return "cm";
    case UNIT_M:    return "m";
    case UNIT_INCH: return "in";
    default:        return "mm";
  }
}

