// ==========================================
// --- Master Control Handling ---
// ==========================================
void handleMetroSureTouch(uint16_t x, uint16_t y) {
  if (showing_finish_modal) {
    if (x >= 160 && x <= 320 && y >= 195 && y <= 245) {
      showing_finish_modal = false;
      drawMetroSureDashboard();
    }
    return;
  }

  if (showing_keypad) {
    handleKeypadTouch(x, y);
    return;
  }

  if (x >= 5 && x <= 65 && y >= 3 && y <= 27) {
    system_state = STATE_STOPPED;
    current_view = VIEW_MATERIAL_DASHBOARD;
    drawFullUI();
    return;
  }

  if (y >= 35 && y <= 60 && x >= 300) {
    if (x < 340)      current_unit = UNIT_MM;
    else if (x < 380) current_unit = UNIT_CM;
    else if (x < 420) current_unit = UNIT_M;
    else              current_unit = UNIT_INCH;

    drawUnitButtons();
    drawTargetCard();
    drawEncoderCard();
    drawStockInfoCard();
    return;
  }

  if (x >= 10 && x <= 470 && y >= 65 && y <= 125) {
    showing_keypad = true;
    keypad_input = "";
    drawKeypad();
    return;
  }

  if (y >= 240 && y <= 310) {
    if (x >= 10 && x <= 155) {        
      system_state = STATE_RUNNING;
    } else if (x >= 167 && x <= 312) { 
      system_state = STATE_PAUSED;
    } else if (x >= 325 && x <= 470) { 
      system_state = STATE_STOPPED;
      encoder_pulse_count = 0;
      raw_encoder_mm = 0.0f;
      prev_drawn_encoder_mm = -1.0f;
      drawEncoderCard();
    }
  }
}

void drawFullUI() {
  switch (current_view) {
    case VIEW_LOGIN:              drawLoginScreen(); break;
    case VIEW_MATERIAL_DASHBOARD: drawMaterialDashboard(); break;
    case VIEW_METROSURE:          drawMetroSureDashboard(); break;
  }
}

void handleTouch(uint16_t x, uint16_t y) {
  if (millis() - last_touch_time < TOUCH_DEBOUNCE_MS) return;
  last_touch_time = millis();

  switch (current_view) {
    case VIEW_LOGIN:              handleLoginTouch(x, y); break;
    case VIEW_MATERIAL_DASHBOARD: handleMaterialTouch(x, y); break;
    case VIEW_METROSURE:          handleMetroSureTouch(x, y); break;
  }
}

// ==========================================
// --- Setup & Main Loop ---
// ==========================================
void setup() {
  Serial.begin(115200);

  pinMode(ENCODER_PIN_A, INPUT_PULLUP);
  pinMode(ENCODER_PIN_B, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(ENCODER_PIN_A), readEncoderISR, RISING);

  lcd.init();
  lcd.setRotation(1);

  drawFullUI();
}

void loop() {
  uint16_t x, y;
  if (lcd.getTouch(&x, &y)) {
    handleTouch(x, y);
  }

  raw_encoder_mm = encoder_pulse_count * MM_PER_PULSE;
  if (raw_encoder_mm < 0.0f) raw_encoder_mm = 0.0f;

  if (current_view == VIEW_METROSURE && !showing_keypad && !showing_finish_modal) {
    if (abs(raw_encoder_mm - prev_drawn_encoder_mm) >= 0.01f) {
      prev_drawn_encoder_mm = raw_encoder_mm;
      drawEncoderCard();
    }
  }

  if (current_view == VIEW_METROSURE && system_state == STATE_RUNNING && raw_target_mm > 0.0f) {
    if (raw_encoder_mm >= raw_target_mm && !showing_finish_modal) {
      system_state = STATE_STOPPED;
      piece_count++;

      MaterialItem &mat = materials[selected_material_idx];
      
      if (mat.total_length_left_mm >= raw_target_mm) {
        mat.total_length_left_mm -= raw_target_mm;
      } else {
        mat.total_length_left_mm = 0.0f;
      }
      
      mat.total_length_cut_mm += raw_target_mm;

      if (mat.std_bar_length_mm > 0) {
        mat.total_bars_left = (uint32_t)(mat.total_length_left_mm / mat.std_bar_length_mm);
      }

      drawStockInfoCard();
      drawFinishPopup();
    }
  }
}
