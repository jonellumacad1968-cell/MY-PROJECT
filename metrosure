#include <LovyanGFX.hpp>

// ==========================================
// --- Enums & Data Structures (Declared Early) ---
// ==========================================
enum AppView { VIEW_LOGIN, VIEW_MATERIAL_DASHBOARD, VIEW_METROSURE };
enum UnitMode { UNIT_MM, UNIT_CM, UNIT_M, UNIT_INCH };
enum SystemState { STATE_STOPPED, STATE_RUNNING, STATE_PAUSED };

struct MaterialItem {
  const char* name;
  float std_bar_length_mm;    // Standard length per piece (e.g. 6000mm = 6m)
  uint32_t total_bars_left;   // Remaining count of full pieces
  float total_length_left_mm; // Remaining total length (mm)
  float total_length_cut_mm;  // Accumulated length cut (mm)
};

// ==========================================
// --- Forward Declarations ---
// ==========================================
float convertFromMM(float mm, UnitMode u);
float convertToMM(float val, UnitMode u);
const char* getUnitStr(UnitMode u);
void drawFullUI();

// ==========================================
// --- Hardware Setup ---
// ==========================================
class LGFX : public lgfx::LGFX_Device {
  lgfx::Panel_ST7796  _panel_instance; 
  lgfx::Bus_SPI       _bus_instance;
  lgfx::Touch_FT5x06  _touch_instance;

public:
  LGFX() {
    { // SPI Bus Config
      auto cfg = _bus_instance.config();
      cfg.spi_host = SPI2_HOST;
      cfg.spi_mode = 0;
      cfg.freq_write = 27000000;
      cfg.pin_sclk = 12;
      cfg.pin_mosi = 11;
      cfg.pin_miso = -1;
      cfg.pin_dc   = 8;
      _bus_instance.config(cfg);
      _panel_instance.setBus(&_bus_instance);
    }

    { // Panel Config
      auto cfg = _panel_instance.config();
      cfg.pin_cs           = 10;
      cfg.pin_rst          = 9;
      cfg.pin_busy         = -1;
      cfg.panel_width      = 320;
      cfg.panel_height     = 480;
      cfg.offset_x         = 0;
      cfg.offset_y         = 0;
      cfg.invert           = true;
      _panel_instance.config(cfg);
    }

    { // Touch Config
      auto cfg = _touch_instance.config();
      cfg.x_min      = 0;
      cfg.x_max      = 319;
      cfg.y_min      = 0;
      cfg.y_max      = 479;
      cfg.pin_int    = 3;
      cfg.pin_rst    = 4;
      cfg.bus_shared = false;
      cfg.i2c_port   = 0;
      cfg.pin_scl    = 2;
      cfg.pin_sda    = 1;
      cfg.freq       = 400000;
      cfg.i2c_addr   = 0x38;
      _touch_instance.config(cfg);
      _panel_instance.setTouch(&_touch_instance);
    }

    setPanel(&_panel_instance);
  }
};

LGFX lcd;

// ==========================================
// --- Rotary Encoder Pins & Calibration ---
// ==========================================
#define ENCODER_PIN_A 6
#define ENCODER_PIN_B 5

const float MM_PER_PULSE = 0.10f; 

volatile long encoder_pulse_count = 0;
float prev_drawn_encoder_mm = -1.0f;

void IRAM_ATTR readEncoderISR() {
  int valB = digitalRead(ENCODER_PIN_B);
  if (valB > 0) {
    encoder_pulse_count++;
  } else {
    encoder_pulse_count--;
  }
}

