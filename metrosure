  lcd.fillRect(20, 10, 440, 50, COLOR_CARD_BG);
  lcd.drawRect(20, 10, 440, 50, COLOR_LINE);

  const char* keys[4][3] = {
    {"1", "2", "3"},
    {"4", "5", "6"},
    {"7", "8", "9"},
    {".", "0", "CLR"}
  };

  int start_x = 40, start_y = 70, kw = 90, kh = 45, gap = 10;

  for (int r = 0; r < 4; r++) {
    for (int c = 0; c < 3; c++) {
      int x = start_x + c * (kw + gap);
      int y = start_y + r * (kh + gap);
      
      lcd.fillRect(x, y, kw, kh, COLOR_BTN_BG);
      lcd.drawRect(x, y, kw, kh, COLOR_LINE);

      lcd.setTextDatum(MC_DATUM);
      lcd.setTextSize(2);
      lcd.setTextColor(COLOR_TEXT, COLOR_BTN_BG);
      lcd.drawString(keys[r][c], x + kw / 2, y + kh / 2);
    }
  }

  lcd.fillRect(340, 70, 100, 100, COLOR_BTN_BG);
  lcd.drawRect(340, 70, 100, 100, COLOR_LINE);
  lcd.setTextDatum(MC_DATUM);
  lcd.setTextSize(2);
  lcd.setTextColor(COLOR_TEXT, COLOR_BTN_BG);
  lcd.drawString("OK", 390, 120);

  lcd.fillRect(340, 185, 100, 105, COLOR_BTN_BG);
  lcd.drawRect(340, 185, 100, 105, COLOR_LINE);
  lcd.setTextColor(COLOR_TEXT, COLOR_BTN_BG);
  lcd.drawString("CANCEL", 390, 237);

  lcd.endWrite();
  updateKeypadDisplay();
}

void handleKeypadTouch(uint16_t x, uint16_t y) {
  int start_x = 40, start_y = 70, kw = 90, kh = 45, gap = 10;

  for (int r = 0; r < 4; r++) {
    for (int c = 0; c < 3; c++) {
      int kx = start_x + c * (kw + gap);
      int ky = start_y + r * (kh + gap);

      if (x >= kx && x <= (kx + kw) && y >= ky && y <= (ky + kh)) {
        if (r == 3 && c == 0) {
          if (keypad_input.indexOf('.') == -1) {
            if (keypad_input.length() == 0) keypad_input = "0";
            keypad_input += ".";
          }
        } else if (r == 3 && c == 2) {
          keypad_input = "";
        } else {
          if (keypad_input.length() < 8) {
            keypad_input += (r == 3 && c == 1) ? "0" : String(r * 3 + c + 1);
          }
        }
        updateKeypadDisplay();
        return;
      }
    }
  }

  if (x >= 340 && x <= 440 && y >= 70 && y <= 170) {
    if (keypad_input.length() > 0) {
      float val = keypad_input.toFloat();
      raw_target_mm = convertToMM(val, current_unit);
    }
    showing_keypad = false;
    drawFullUI();
  }

  if (x >= 340 && x <= 440 && y >= 185 && y <= 290) {
    showing_keypad = false;
    drawFullUI();
  }
}

