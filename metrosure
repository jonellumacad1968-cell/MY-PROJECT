void drawLoginScreen() {
  lcd.startWrite();
  lcd.fillScreen(COLOR_BG);

  lcd.fillRect(0, 0, 480, 35, COLOR_HEADER);
  lcd.drawFastHLine(0, 35, 480, COLOR_LINE);
  lcd.setTextDatum(MC_DATUM);
  lcd.setTextSize(2);
  lcd.setTextColor(COLOR_TEXT, COLOR_HEADER);
  lcd.drawString("METROSURE LOGIN", 240, 18);

  lcd.fillRect(40, 50, 400, 55, COLOR_CARD_BG);
  lcd.drawRect(40, 50, 400, 55, COLOR_LINE);

  lcd.setTextDatum(TL_DATUM);
  lcd.setTextSize(1);
  lcd.setTextColor(COLOR_TEXT, COLOR_CARD_BG);
  lcd.drawString("ENTER EMPLOYEE PIN:", 50, 55);

  String masked = "";
  for (unsigned int i = 0; i < input_pin.length(); i++) masked += "*";
  lcd.setTextDatum(MC_DATUM);
  lcd.setTextSize(3);
  lcd.drawString(masked, 240, 85);

  const char* keys[4][3] = {
    {"1", "2", "3"},
    {"4", "5", "6"},
    {"7", "8", "9"},
    {"CLR", "0", "LOGIN"}
  };

  int start_x = 110, start_y = 115, kw = 80, kh = 42, gap = 8;
  for (int r = 0; r < 4; r++) {
    for (int c = 0; c < 3; c++) {
      int x = start_x + c * (kw + gap);
      int y = start_y + r * (kh + gap);
      lcd.fillRect(x, y, kw, kh, COLOR_BTN_BG);
      lcd.drawRect(x, y, kw, kh, COLOR_LINE);
      lcd.setTextSize(2);
      lcd.setTextColor(COLOR_TEXT, COLOR_BTN_BG);
      lcd.drawString(keys[r][c], x + kw / 2, y + kh / 2);
    }
  }
  lcd.endWrite();
}

void handleLoginTouch(uint16_t x, uint16_t y) {
  int start_x = 110, start_y = 115, kw = 80, kh = 42, gap = 8;

  for (int r = 0; r < 4; r++) {
    for (int c = 0; c < 3; c++) {
      int kx = start_x + c * (kw + gap);
      int ky = start_y + r * (kh + gap);

      if (x >= kx && x <= (kx + kw) && y >= ky && y <= (ky + kh)) {
        if (r == 3 && c == 0) {
          input_pin = "";
        } else if (r == 3 && c == 2) {
          if (input_pin == VALID_PIN) {
            input_pin = "";
            current_view = VIEW_MATERIAL_DASHBOARD;
            drawFullUI();
          } else {
            input_pin = "";
            drawLoginScreen();
          }
          return;
        } else {
          if (input_pin.length() < 6) {
            input_pin += (r == 3 && c == 1) ? "0" : String(r * 3 + c + 1);
          }
        }
        drawLoginScreen();
        return;
      }
    }
  }
}

